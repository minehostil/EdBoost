<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.minehostil</groupId>
    <artifactId>EdBoost</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- EdTools API (JAR local, ver libs/README.md) -->
        <dependency>
            <groupId>es.edwardbelt</groupId>
            <artifactId>edgens-api</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/EdToolsAPI.jar</systemPath>
        </dependency>

        <!-- RivalHarvesterHoes (JAR local, ver libs/README.md) -->
        <dependency>
            <groupId>me.rivaldev</groupId>
            <artifactId>harvesterhoes</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/RivalHarvesterHoes.jar</systemPath>
        </dependency>

        <!-- RivalPickaxes (JAR local, ver libs/README.md) -->
        <dependency>
            <groupId>me.rivaldev</groupId>
            <artifactId>pickaxes</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/RivalPickaxes.jar</systemPath>
        </dependency>

        <!-- RivalMobSwords (JAR local, ver libs/README.md) -->
        <dependency>
            <groupId>me.rivaldev</groupId>
            <artifactId>mobswords</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/RivalMobSwords.jar</systemPath>
        </dependency>

        <!-- CyberLevels (JAR local, ver libs/README.md) -->
        <dependency>
            <groupId>com.bitaspire</groupId>
            <artifactId>cyberlevels</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/CyberLevels.jar</systemPath>
        </dependency>

        <!-- SQLite (shaded) para persistencia de boosts permanentes -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>EdBoost</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>org.sqlite</pattern>
                                    <shadedPattern>com.minehostil.edboost.libs.sqlite</shadedPattern>
                                </relocation>
                            </relocations>
                            <!--
                                sqlite-jdbc empaqueta binarios nativos para
                                prácticamente todos los SO/arquitecturas
                                (Windows, macOS, Linux glibc/musl, FreeBSD,
                                Android, en x86/x86_64/arm/aarch64/ppc64/etc.),
                                lo que infla el JAR final a ~14 MB. MineHostil
                                corre todo en Linux x86_64 vía Pterodactyl
                                (contenedores Debian o Alpine), así que se
                                descartan el resto — si algún nodo usara otra
                                arquitectura (ej. ARM), habría que agregar de
                                vuelta su carpeta nativa correspondiente aquí.
                            -->
                            <filters>
                                <filter>
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <excludes>
                                        <exclude>org/sqlite/native/FreeBSD/**</exclude>
                                        <exclude>org/sqlite/native/Linux/aarch64/**</exclude>
                                        <exclude>org/sqlite/native/Linux/android-arm/**</exclude>
                                        <exclude>org/sqlite/native/Linux/arm/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv6/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv7/**</exclude>
                                        <exclude>org/sqlite/native/Linux/ppc64/**</exclude>
                                        <exclude>org/sqlite/native/Linux/riscv64/**</exclude>
                                        <exclude>org/sqlite/native/Linux/x86/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Musl/aarch64/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Musl/arm/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Android/**</exclude>
                                        <exclude>org/sqlite/native/Mac/**</exclude>
                                        <exclude>org/sqlite/native/Windows/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
